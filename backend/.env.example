# Copy to backend/.env and fill in real values.

# --- Secrets (REQUIRED in production) ---
SECRET_KEY=change-me-long-random-string
JWT_SECRET_KEY=change-me-long-random-jwt-secret
# Optional: JWT expiration in minutes. Omit for non-expiring tokens (dev).
# JWT_TOKEN_EXPIRES_MINUTES=10080

# --- Database ---
# Leave unset to use SQLite (backend/holomedia.db).
# Examples:
# DATABASE_URL=postgresql://user:password@localhost:5432/holomedia
# DATABASE_URL=postgresql://user:password@aws-0-xx.pooler.supabase.com:6543/postgres
DATABASE_URL=

# --- CORS ---
# "*" for dev. For prod use a comma-separated list of allowed origins.
CORS_ORIGINS=*

# --- Uploads ---
MAX_UPLOAD_MB=100

# --- Spotify (optional) ---
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
